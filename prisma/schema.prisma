// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LotteryRound {
  id        Int      @id @default(autoincrement())
  name      String?   // F.eks. "Uke 4, 2026"
  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false)
  aiSummary String?  // Kort oppsummering av ukens viner, laget av AI (Gemini). Kan redigeres i admin
  winesConfirmed Boolean @default(false) // Admin har bekreftet at ukens viner er de riktige (ellers bare forslag)
  quizQuestionIds String[] @default([]) // Ukens quizspørsmål (QuizSporsmal.id), trukket tilfeldig første gang noen starter quizen
  quizBonusGiven  Boolean  @default(false) // Bonusloddene til topp 3 i quizen er delt ut (skjer når salget stenges)
  createdAt DateTime @default(now())
  tickets   Ticket[]
  wines     Wine[]
  quizAttempts QuizAttempt[]
  regnskapsposter Regnskapspost[]
}

// Flaskene som loddes ut i en runde (kun informasjon om ukens premie)
model Wine {
  id       Int     @id @default(autoincrement())
  info     String  // F.eks. "Barolo 2019 – Italia, Piemonte · 75 cl · 14% · Kr 699,90"
  imageUrl String?
  productCode String? // Varenummer hos Vinmonopolet (brukes til å hente mer info)
  position Int     @default(0)

  roundId  Int
  round    LotteryRound @relation(fields: [roundId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Ticket {
  id        Int      @id @default(autoincrement())
  number    Int
  ownerName String?
  isTaken   Boolean  @default(false)
  hasWon    Boolean  @default(false)
  isBonus   Boolean  @default(false) // Gratis bonuslodd til topp 3 i quizen (fra 2027), ikke betalt

  // Relasjon til runden
  roundId   Int
  round     LotteryRound @relation(fields: [roundId], references: [id])

  @@unique([number, roundId]) // Sørger for at nr 1-200 bare finnes én gang per runde
}
// Ukens quiz: ett forsøk per person per runde, kun for dem som har lodd i runden.
// Bare den som startet forsøket kan svare (hemmelig token i en cookie, lagret som hash).
// Fun facts om vin: vises på forsiden og som forklaring etter et quizsvar.
// Redigeres i Supabase sin tabelleditor. active = false skjuler en fact.
model FunFact {
  id        Int            @id @default(autoincrement())
  text      String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  questions QuizSporsmal[]
}

// Spørsmålsbanken til ukens quiz. Ligger i databasen og ikke i koden, fordi
// repoet er offentlig og fasiten ikke skal være det. Redigeres i Supabase.
// id må aldri endres eller gjenbrukes (påbegynte forsøk lagrer den); sett
// heller active = false. options har nøyaktig fire alternativer, og answer er
// indeksen til det riktige (0–3). Rekkefølgen stokkes per runde.
model QuizSporsmal {
  id        String   @id
  text      String
  options   String[]
  answer    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  factId    Int?
  fact      FunFact? @relation(fields: [factId], references: [id], onDelete: SetNull)
}

model QuizAttempt {
  id          Int       @id @default(autoincrement())
  name        String    // Samme skrivemåte som på loddene (canonicalName)
  tokenHash   String    // SHA-256 av tokenet i cookien
  questionIds String[]  // Spørsmålene i forsøket (QuizSporsmal.id)
  answers     Int[]     // Valgt alternativ per besvart spørsmål, -1 = tiden gikk ut
  score       Int       @default(0)
  timeMs      Int       @default(0) // Samlet svartid, skiller like poengsummer
  shownAt     DateTime? // Når spørsmålet som venter på svar ble vist (null = mellom spørsmål)
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  roundId     Int
  round       LotteryRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, name])
}

// Egne poster i regnskapet (admin → Regnskap): inngående saldo, faktiske
// kvitteringer, gebyrer, rettelser osv. Positivt beløp = inn, negativt = ut.
// Inntekt fra lodd og vinkjøp regnes ut automatisk og lagres ikke her.
// roundId knytter posten til en runde (tas med i rundens resultat).
model Regnskapspost {
  id        Int      @id @default(autoincrement())
  dato      DateTime @db.Date
  tekst     String
  belop     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  roundId   Int?
  round     LotteryRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
}

// --- Tabeller som administreres direkte i Supabase ---
// Ligger her så `prisma db push` ikke prøver å slette dem.
// Kakeliste leses med rå SQL på forsiden (neste kakebaker).

model Ansatte {
  id   BigInt  @id @default(autoincrement())
  Navn String?
}

model Kakeliste {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  uke        Int?     @db.SmallInt
  Navn       String?
  aar        Int      @default(dbgenerated("(EXTRACT(year FROM now()))::smallint")) @db.SmallInt
}

// Andre skrivemåter for samme person, f.eks. initialer eller fullt navn
// («ON» → «Ola N»). Brukes når lodd kjøpes, så samme person alltid får
// samme navn. alias lagres med små bokstaver; navn bør stå som i Ansatte.
// Ligger i databasen (ikke i koden) fordi repoet er offentlig.
model NavneAlias {
  alias String @id
  navn  String
}

// Mislykkede admin-innlogginger, brukes til å begrense antall forsøk.
// ipHash er en SHA-256 av IP-adressen, ikke selve adressen.
model AdminLoginAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

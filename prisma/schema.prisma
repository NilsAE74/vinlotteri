// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LotteryRound {
  id        Int      @id @default(autoincrement())
  name      String?   // F.eks. "Uke 4, 2026"
  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false)
  aiSummary String?  // Kort oppsummering av ukens viner, laget av AI (Gemini). Kan redigeres i admin
  createdAt DateTime @default(now())
  tickets   Ticket[]
  wines     Wine[]
}

// Flaskene som loddes ut i en runde (kun informasjon om ukens premie)
model Wine {
  id       Int     @id @default(autoincrement())
  info     String  // F.eks. "Barolo 2019 – Italia, Piemonte · 75 cl · 14% · Kr 699,90"
  imageUrl String?
  productCode String? // Varenummer hos Vinmonopolet (brukes til å hente mer info)
  position Int     @default(0)

  roundId  Int
  round    LotteryRound @relation(fields: [roundId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Ticket {
  id        Int      @id @default(autoincrement())
  number    Int
  ownerName String?
  isTaken   Boolean  @default(false)
  hasWon    Boolean  @default(false)

  // Relasjon til runden
  roundId   Int
  round     LotteryRound @relation(fields: [roundId], references: [id])

  @@unique([number, roundId]) // Sørger for at nr 1-200 bare finnes én gang per runde
}
// --- Tabeller som administreres direkte i Supabase ---
// Ligger her så `prisma db push` ikke prøver å slette dem.
// Kakeliste leses med rå SQL på forsiden (neste kakebaker).

model Ansatte {
  id   BigInt  @id @default(autoincrement())
  Navn String?
}

model Kakeliste {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  uke        Int?     @db.SmallInt
  Navn       String?
  aar        Int      @default(dbgenerated("(EXTRACT(year FROM now()))::smallint")) @db.SmallInt
}

// Mislykkede admin-innlogginger, brukes til å begrense antall forsøk.
// ipHash er en SHA-256 av IP-adressen, ikke selve adressen.
model AdminLoginAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([ipHash, createdAt])
  @@index([createdAt])
}
